#!/bin/sh

root="$(git rev-parse --show-toplevel)"

echo "pre-push: проверка типов backend (tsc --noEmit)..."
(cd "$root/backend" && npx tsc --noEmit) || exit 1

echo "pre-push: проверка форматирования backend (prettier --check)..."
(cd "$root/backend" && npx prettier --check .) || exit 1

echo "pre-push: проверка форматирования frontend (prettier --check)..."
(cd "$root/frontend" && npx prettier --check .) || exit 1
