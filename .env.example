# Domain that Caddy will request a Let's Encrypt certificate for
DOMAIN=moodly.example.com

# Backend CORS allowlist — must match the scheme+domain above
FRONTEND_URL=https://moodly.example.com

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=

# "lax" is correct when frontend and backend share an origin (Caddy ensures this)
COOKIE_SAMESITE=lax

# Postgres (the postgres service in docker-compose.yml)
POSTGRES_USER=moodly
POSTGRES_PASSWORD=
POSTGRES_DB=moodly
