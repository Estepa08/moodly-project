generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  // 18+ confirmation and personal-data processing consent, recorded at
  // registration time so consent can be demonstrated per account rather than
  // relying on a client-side-only flag.
  ageConfirmed      Boolean   @default(false)
  consentAcceptedAt DateTime?
  consentVersion    String?

  entries     Entry[]
  testResults TestResult[]
  feedback    Feedback[]
  reports     Report[]
  refreshTokens RefreshToken[]
  resetTokens   ResetToken[]
  breathingSessions BreathingSession[]
  practiceCompletions PracticeCompletion[]
  cbaEntries    CbaEntry[]
  userPreference UserPreference?
  pushSubscriptions PushSubscription[]
}

model Parameter {
  id          String @id @default(cuid())
  name        String
  description String?
  unit        String?

  entries Entry[]
}

model Entry {
  id          String   @id @default(cuid())
  userId      String
  parameterId String
  value       Float
  note        String?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  parameter Parameter @relation(fields: [parameterId], references: [id])

  @@index([userId])
  @@index([parameterId])
  @@index([userId, parameterId])
}

model Test {
  id          String @id @default(cuid())
  title       String
  description String?
  questions   Json

  results TestResult[]
}

model TestResult {
  id             String   @id @default(cuid())
  testId         String
  userId         String
  score          Int
  interpretation String
  recommendation String
  flags          Json?
  completedAt    DateTime @default(now())

  test Test @relation(fields: [testId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([testId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OnboardingStory {
  id      String @id @default(cuid())
  title   String
  content String
  order   Int
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  format      String
  status      String   @default("pending")
  periodFrom  DateTime
  periodTo    DateTime
  createdAt   DateTime @default(now())
  downloadUrl String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CreatureState {
  id             String   @id @default(cuid())
  userId         String   @unique
  calmness       Int      @default(50)
  energy         Int      @default(100)
  level          Int      @default(1)
  experience     Int      @default(0)
  streak         Int      @default(0)
  lastCheckInAt  DateTime?
  lastExerciseAt DateTime?
}

model UserPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  goals           Json    @default("[]")
  experienceLevel String  @default("beginner")
  dailyReminder   Boolean @default(false)
  reminderTime    String? @default("09:00")
  onboardingDone  Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

model PracticeCompletion {
  id        String   @id @default(cuid())
  userId    String
  source    String
  xpAwarded Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
}

model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model BreathingSession {
  id              String   @id @default(cuid())
  userId          String
  duration        Int
  initialCalmness Int
  finalCalmness   Int
  completedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CbaExample {
  id          String @id @default(cuid())
  persona     String
  thoughtText String
  prosWeight  Int
  consWeight  Int
  order       Int    @default(0)

  items       CbaExampleItem[]
  distortions CbaExampleDistortion[]
}

model CbaExampleItem {
  id        String @id @default(cuid())
  exampleId String
  itemType  String
  itemText  String

  example CbaExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@index([exampleId])
}

model CbaExampleDistortion {
  id            String @id @default(cuid())
  exampleId     String
  distortionKey String

  example CbaExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@index([exampleId])
}

model CbaCommonItem {
  id       String @id @default(cuid())
  itemType String
  itemText String
}

model CbaEntry {
  id          String   @id @default(cuid())
  userId      String
  thoughtText String
  prosWeight  Int
  consWeight  Int
  createdAt   DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id])
  items CbaEntryItem[]

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CbaEntryItem {
  id       String @id @default(cuid())
  entryId  String
  itemType String
  itemText String

  entry CbaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}
