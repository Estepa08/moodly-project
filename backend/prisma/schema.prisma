generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  password              String
  name                  String?
  role                  String                 @default("user")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  subscriptionTier      String                 @default("free")
  subscriptionExpiresAt DateTime?
  emotionLabProgress    EmotionLabProgress?

  // 18+ confirmation and personal-data processing consent, recorded at
  // registration time so consent can be demonstrated per account rather than
  // relying on a client-side-only flag.
  ageConfirmed      Boolean   @default(false)
  pdpConsent        Boolean   @default(false)
  birthYear         Int?
  consentAcceptedAt DateTime?
  consentVersion    String?

  // Email verification
  emailVerified Boolean @default(false)

  // E2E-шифрование: DEK, зашифрованный KEK (из пароля) и KEK_recovery (из recovery-кода).
  // Ключи генерируются на клиенте; сервер хранит только wrappedKey и соли и не может
  // расшифровать данные пользователя.
  wrappedKey        String?
  keySalt           String?
  recoveryWrappedKey String?
  recoverySalt      String?

  entries     Entry[]
  testResults TestResult[]
  feedback    Feedback[]
  reports     Report[]
  refreshTokens RefreshToken[]
  resetTokens   ResetToken[]
  breathingSessions BreathingSession[]
  practiceCompletions PracticeCompletion[]
  cbaEntries    CbaEntry[]
  userPreference UserPreference?
  pushSubscriptions PushSubscription[]
  userAchievements UserAchievement[]
  creatureState CreatureState?
  dailyMissions  DailyMission[]
  devices   Device[]
  syncCursor SyncCursor?
}

model Parameter {
  id          String @id @default(cuid())
  name        String
  description String?
  unit        String?

  entries Entry[]
}

model Entry {
  id             String   @id @default(cuid())
  userId         String
  parameterId    String
  value          Float?
  note           String?
  // E2E: шифротекст {value, note}. value/note ниже nullable — только для миграции
  // существующих данных; новые записи хранят значение только в encryptedData.
  encryptedData  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parameter Parameter @relation(fields: [parameterId], references: [id])

  @@index([userId])
  @@index([parameterId])
  @@index([userId, parameterId])
  @@index([userId, updatedAt])
}

model Test {
  id          String  @id @default(cuid())
  title       String
  description String?
  type        String  @default("standard")
  questions   Json
  active      Boolean @default(true)

  results    TestResult[]
  scoreBands TestScoreBand[]
}

model TestScoreBand {
  id             String @id @default(cuid())
  testId         String
  maxScore       Int
  key            String
  interpretation String
  recommendation String

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model TestResult {
  id             String   @id @default(cuid())
  testId         String
  userId         String
  score          Int?
  interpretation String?
  recommendation String?
  flags          Json?
  // E2E: шифротекст {score, interpretation, recommendation, flags}.
  // Открытые поля выше nullable — только для миграции существующих данных.
  encryptedData  String?
  completedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  test Test @relation(fields: [testId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
  @@index([userId, updatedAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int      @default(0)
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
}

model OnboardingStory {
  id      String @id @default(cuid())
  title   String
  content String
  order   Int
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  format      String
  status      String   @default("pending")
  periodFrom  DateTime
  periodTo    DateTime
  createdAt   DateTime @default(now())
  downloadUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String
  titleKey    String
  descKey     String
  iconName    String
  skinReward    String?
  titleReward   String?
  petTypeReward String?
  xpReward      Int      @default(0)
  criteria    Json
  sortOrder   Int      @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  notified      Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([userId, updatedAt])
}

model CreatureState {
  id               String   @id @default(cuid())
  userId           String   @unique
  calmness         Int      @default(50)
  energy           Int      @default(100)
  level            Int      @default(1)
  experience       Int      @default(0)
  streak           Int      @default(0)
  lastCheckInAt    DateTime?
  lastExerciseAt   DateTime?
  activeSkin       String   @default("default")
  unlockedSkins    String[] @default(["default"])
  activeTitle      String?
  unlockedTitles   String[] @default([])
  petType          String   @default("puff")
  unlockedPetTypes String[] @default(["puff", "fox"])
  petName          String?
  // E2E: настроение питомца считает клиент (сервер больше не видит entry.value).
  petMood          String?
  feedCount        Int      @default(0)
  feedCounts       Json     @default("{}")
  // Дата последнего поглаживания и счётчик поглаживаний за текущий день.
  // Счётчик сбрасывается в 0 при наступлении нового дня (см. creature.ts).
  lastPetAt        DateTime?
  petCount         Int      @default(0)
  // «Утешение» — скрытый параметр, растёт от бонуса «Эмпатия» (грустное настроение).
  comfort          Int      @default(0)
  // Сколько кликов бонуса «Возвращение» уже использовано после паузы > 4 ч.
  welcomeUsed      Int      @default(0)
  // Недавние времена поглаживаний (для подсчёта серии «Комбо»).
  petTimes         Json     @default("[]")
  // «Играть»: дневной счётчик игр и дата последней игры (сброс по дню, как petCount/lastPetAt).
  playCount        Int      @default(0)
  lastPlayAt       DateTime?
  // Неделя (ключ = дата понедельника), за которую уже забран недельный подарок +XP.
  weeklyClaimWeek  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  goals           Json    @default("[]")
  experienceLevel String  @default("beginner")
  // Слот «Утро» (наследует прежние dailyReminder/reminderTime).
  dailyReminder   Boolean @default(false)
  reminderTime    String? @default("09:00")
  // Слот «День».
  afternoonReminder Boolean @default(false)
  afternoonTime     String? @default("14:00")
  // Слот «Вечер» — итог дня («Мой день»).
  eveningReminder   Boolean @default(false)
  eveningTime       String? @default("20:00")
  onboardingDone       Boolean @default(false)
  showSupportResources Boolean @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MotivationMessage {
  id        String   @id @default(cuid())
  type      String // "morning" | "evening"
  locale    String // "ru" | "en"
  text      String
  question  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, locale, isActive])
}

model PracticeCompletion {
  id        String   @id @default(cuid())
  userId    String
  source    String
  xpAwarded Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
}

model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String?
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  name       String
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model SyncCursor {
  userId       String   @id
  lastPulledAt DateTime @default(now())
  lastPulledId String?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Игровой прогресс «Лаборатории эмоций» (алхимия на основе колеса Плутчика).
// Открытие диад и дневной лимит попыток — игровая механика, НЕ чувствительные
// данные, поэтому хранятся на сервере открыто (в отличие от записей трекера).
// dailyAttemptsUsed сбрасывается в 0 при наступлении нового дня (см. emotion-lab.ts).
model EmotionLabProgress {
  id                String   @id @default(cuid())
  userId            String   @unique
  dailyAttemptsUsed Int      @default(0)
  lastAttemptDate   DateTime?
  discoveredDyads   String[] @default([]) // ключи диад, напр. "love", "guilt"
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BreathingSession {
  id              String   @id @default(cuid())
  userId          String
  duration        Int
  initialCalmness Int
  finalCalmness   Int
  completedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
}

model CbaExample {
  id          String @id @default(cuid())
  persona     String
  thoughtText String
  prosWeight  Int
  consWeight  Int
  order       Int    @default(0)

  items       CbaExampleItem[]
  distortions CbaExampleDistortion[]
}

model CbaExampleItem {
  id        String @id @default(cuid())
  exampleId String
  itemType  String
  itemText  String

  example CbaExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@index([exampleId])
}

model CbaExampleDistortion {
  id            String @id @default(cuid())
  exampleId     String
  distortionKey String

  example CbaExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@index([exampleId])
}

model CbaCommonItem {
  id       String @id @default(cuid())
  itemType String
  itemText String
  category String
  itemKey  String

  @@index([itemType, category])
}

model CbaEntry {
  id          String   @id @default(cuid())
  userId      String
  thoughtText String
  prosWeight  Int
  consWeight  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CbaEntryItem[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model DailyMission {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  missionKey String
  labelKey   String
  xpReward   Int      @default(10)
  claimed    Boolean  @default(false)
sortOrder  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@unique([userId, date, missionKey])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CbaEntryItem {
  id       String @id @default(cuid())
  entryId  String
  itemType String
  itemText String
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  entry CbaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}