# Шаблон тестового окружения backend.
# Скопируйте в backend/.env.test и подставьте свой локальный пользователь БД.
# Файл .env.test в .gitignore и не коммитится.
#
# JWT_SECRET используется тестами как fallback (src/test/setup.ts),
# значение должно совпадать с ним, если вы реально загружаете этот файл.
#
# Перед первым запуском тестов (и после любых изменений schema.prisma)
# нужно вручную создать/пересоздать схему в тестовой БД:
#   npm run db:test:reset
# Сами тесты (src/test/setup.ts) схему больше не трогают — только чистят
# данные через TRUNCATE перед каждым тестовым файлом.

DATABASE_URL="postgresql://YOUR_USER@localhost:5432/moodly_test?schema=public"
DIRECT_URL="postgresql://YOUR_USER@localhost:5432/moodly_test?schema=public"
JWT_SECRET="change-me"
PORT=3002
FRONTEND_URL="http://localhost:5173"
