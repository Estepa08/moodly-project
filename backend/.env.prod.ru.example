# RU-прод: Docker Host PostgreSQL + хостинг Amvera + домен mymoodly.ru.
# Скопируйте этот файл в backend/.env.prod.ru.local и заполните секреты
# (файл .env.prod.ru.local в .gitignore и не коммитится).

# --- PostgreSQL (Docker Host) — одна строка для DATABASE_URL и DIRECT_URL ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/mood_diary?sslmode=disable&schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@postgres:5432/mood_diary?sslmode=disable&schema=public
FRONTEND_URL=https://mymoodly.ru
COOKIE_SAMESITE=lax
NODE_ENV=production

# --- JWT ---
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# --- Email (временно Resend) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@mymoodly.ru

# --- Push-уведомления (web-push, провайдер-независимо) ---
# Сгенерировать: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@mymoodly.ru