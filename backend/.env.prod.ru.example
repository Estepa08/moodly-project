# RU-прод: Docker Host PostgreSQL + хостинг DockHost (my.dockhost.ru) + домен mymoodly.ru.
# Скопируйте этот файл в backend/.env.prod.ru.local и заполните секреты
# (файл .env.prod.ru.local в .gitignore и не коммитится).

# --- PostgreSQL (Docker Host) — одна строка для DATABASE_URL и DIRECT_URL ---
# Трафик к Postgres только по TLS (sslmode=require).
# ПЕРЕД запуском включите SSL на контейнере postgres:
#   - положите в /etc/postgresql/ server.crt + server.key (self-signed допустим)
#   - параметры конфига: ssl=on, ssl_cert_file, ssl_key_file
#   - пересоздайте контейнер
# Если SSL на Postgres не включён, приложение упадёт при старте (fail-fast) —
# это ожидаемо. Только для строго приватной docker-сети (без доступа извне)
# допустимо sslmode=disable, но не рекомендуется.
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/mood_diary?sslmode=require&schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@postgres:5432/mood_diary?sslmode=require&schema=public
FRONTEND_URL=https://mymoodly.ru
COOKIE_SAMESITE=lax
NODE_ENV=production

# --- JWT ---
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# --- Email (временно Resend) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@mymoodly.ru

# --- Push-уведомления (web-push, провайдер-независимо) ---
# Сгенерировать: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@mymoodly.ru