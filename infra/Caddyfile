# --- Глобальные настройки ---
{
    # Внешний TLS/домен закрывает reverse proxy панели DockHost (Traefik).
    # Caddy внутри контейнера слушает обычный HTTP на порту 80.
    auto_https off
}

# --- Caddy слушает HTTP на порту, куда панель проксирует маршрут ---
:80 {
    # Исторический домен mymoodly.online не является основным (основной — mymoodly.ru).
    # Он не используется — навсегда отдаём 301 на канонический,
    # чтобы Google склеил сигналы и убрал .online из выдачи по "mymoodly".
    @moodlyonline host mymoodly.online www.mymoodly.online
    redir @moodlyonline https://mymoodly.ru{uri} permanent

    # Указываем папку, откуда Caddy будет раздавать статику
    root * /srv
    encode gzip

    # --- Общие security-заголовки (SPA + API) ---
    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy same-origin
        # HSTS игнорируется браузером на чистом HTTP, заработает после включения TLS
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # 1. Обработка запросов к API (прокси на бэкенд)
    handle /api/* {
        uri strip_prefix /api
        # Проксируем на бэкенд (IPv4, т.к. Fastify слушает 0.0.0.0:3001;
        # localhost может резолвиться в ::1 и давать 503)
        reverse_proxy 127.0.0.1:3001 {
            # Проверяем, что бэкенд жив, чтобы не было 502 ошибок
            health_uri /health
            health_interval 5s
            health_timeout 2s
        }
    }

    # 2. Обработка всех остальных запросов (SPA-маршрутизация)
    handle {
        # CSP для SPA: Vite-бандл из 'self', инлайн-стили React/Tailwind,
        # Google Fonts (fonts.googleapis.com / fonts.gstatic.com), data:/blob: картинки,
        # Яндекс.Метрика (mc.yandex.ru / yastatic.net / yandex.ru / yandex.net)
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://yastatic.net; worker-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://yastatic.net https://yandex.ru https://yandex.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
        # Пытаемся найти файл. Сначала реальные файлы ({path}), затем
        # пререндеренный HTML маршрута ({path}/index.html), и только потом
        # SPA-fallback для несуществующих путей (React 404).
        # Пререндер (frontend/scripts/prerender.mjs) кладёт статический HTML
        # в dist/<route>/index.html — его отдают роботам/браузерам сразу.
        try_files {path} {path}/index.html /index.html
        # Раздаём файлы из корня /srv
        file_server
    }
}
