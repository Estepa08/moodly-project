:{$PORT} {
    root * /srv
    encode gzip

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy {$BACKEND_UPSTREAM} {
            health_uri /health
            health_interval 5s
            health_timeout 2s
        }
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
