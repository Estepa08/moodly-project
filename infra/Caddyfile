# --- Глобальные настройки ---
{
    # Внешний TLS/домен закрывает reverse proxy панели DockHost (Traefik).
    # Caddy внутри контейнера слушает обычный HTTP на порту 80.
    auto_https off
}

# --- Caddy слушает HTTP на порту, куда панель проксирует маршрут ---
:80 {
    # Указываем папку, откуда Caddy будет раздавать статику
    root * /srv
    encode gzip

    # 1. Обработка запросов к API (прокси на бэкенд)
    handle /api/* {
        uri strip_prefix /api
        # Проксируем на ваш бэкенд, который слушает порт 3001 внутри контейнера
        reverse_proxy localhost:3001 {
            # Проверяем, что бэкенд жив, чтобы не было 502 ошибок
            health_uri /health
            health_interval 5s
            health_timeout 2s
        }
    }

    # 2. Обработка всех остальных запросов (SPA-маршрутизация)
    handle {
        # Пытаемся найти файл. Если не найден - отдаём index.html
        # Это нужно для SPA, чтобы React/Vue обрабатывали маршруты сами
        try_files {path} /index.html
        # Раздаём файлы из корня /srv
        file_server
    }
}
