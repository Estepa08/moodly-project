{
  "name": "moodly-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../api-contract/generated/openapi.yaml -o src/lib/api-types.ts",
    "generate": "npm run generate:api",
    "test": "vitest run",
    "bundle:check": "node scripts/check-bundle.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/fix-shared-link.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@moodly/shared": "file:../../shared",
    "@nivo/core": "^0.99.0",
    "@nivo/radar": "^0.99.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dexie": "^4.4.4",
    "framer-motion": "^13.1.0",
    "i18next": "^26.3.6",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@locator/babel-jsx": "^0.5.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-react-click-to-component": "^4.2.2",
    "vitest": "^4.1.10"
  }
}
